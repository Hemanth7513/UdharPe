# Frontend (Vite) — set in Vercel / local .env (do not commit secrets)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Comma-separated emails allowed as platform admin (optional if using app_metadata.role=superadmin)
VITE_SUPERADMIN_EMAILS=

# Supabase Edge Function secrets (supabase secrets set ...)
RESEND_API_KEY=
RESEND_FROM_EMAIL=UdharPe <noreply@yourdomain.com>
FRONTEND_URL=https://udhar-pe.vercel.app
CRON_SECRET=
SUPERADMIN_EMAILS=

